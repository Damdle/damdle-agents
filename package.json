{
  "name": "damdle-agents-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "agent": "node --experimental-strip-types --import ./scripts/register-typescript-loader.mjs packages/hosts/node-local/src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "demo": "node --experimental-strip-types --import ./scripts/register-typescript-loader.mjs packages/examples/local/src/demo.ts",
    "demo:mcp": "node --experimental-strip-types --import ./scripts/register-typescript-loader.mjs packages/examples/generic-mcp/src/demo.ts",
    "check:publication": "node scripts/check-publication.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@napi-rs/keyring": "^2.1.2",
    "ajv": "^8.17.1"
  }
}
